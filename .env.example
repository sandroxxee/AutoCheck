# ==============================================================================
# AutoCheck Brasil - Configurações de Gateways Oficiais & Variáveis de Ambiente
# ==============================================================================

# 1. APIBrasil - Gateway Integrado Multibases Veiculares (gateway.apibrasil.io)
# Autenticação oficial: Bearer Token da conta APIBrasil e Device Token
APIBRASIL_BEARER_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwczovL2FwcC5hcGlicmFzaWwuaW8vYXBpL3YyL2F1dGgvbG9naW4iLCJpYXQiOjE3OTMxODQ1NDcsImV4cCI6MTgyNDcyMDU0NywibmJmIjoxNzkzMTg0NTQ3LCJqdGkiOiJYWkNWN2pMMFphcWt2NUZOIiwic3ViIjoiNTgyMDQiLCJzZWFyY2giOiI4NjMwYWY4MS04NmM0LTQ2YmEtOGI5Yi1kZGUzMGJjZjFlZWUifQ.llcplkxvdYHEYR2HEqhyiEODeseJFF4VqDNMFIcZw2Q
APIBRASIL_DEVICE_TOKEN=
# Base 000: Dados cadastrais básicos (BIN / Renavam / Motor / Chassi)
APIBRASIL_BASE000_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/000
APIBRASIL_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/000
# Base 001: Busca Completa (Histórico de Leilão, Leiloeiros, Indício de Sinistro, Perda Total & Recalls)
APIBRASIL_BASE001_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/001
# Base 002: Débitos & Multas Estaduais/Federais (IPVA, Licenciamento anual, DPVAT e Multas RENAINF)
APIBRASIL_BASE002_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/002
APIBRASIL_DEBITOS_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/002
# Base 003: Gravame SNG (Alienação Fiduciária, Reserva de Domínio e Arrendamento Mercantil B3)
APIBRASIL_BASE003_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/003
# Base 004: Bloqueios Judiciais (RENAJUD, Penhoras Trabalhistas/Cíveis e Restrições DETRAN)
APIBRASIL_BASE004_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/004
# Base 005: Histórico de Preços FIPE & Cotações de Mercado
APIBRASIL_BASE005_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/005

# 2. BrasilAPI - Base Aberta e Pública Nacional (brasilapi.com.br)
# Fornece: Tabela FIPE (Preços e Histórico), Consulta de CEP, CNPJ e Indicadores Econômicos
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# 3. SINESP Cidadão / MJSP - Alerta Policial de Roubo e Furto Nacional
# Canal integrado de checagem criminal de veículos
SINESP_GATEWAY_URL=https://sinesp.mj.gov.br/api/v1/veiculos
SINESP_API_KEY=

# 4. SNG / B3 - Sistema Nacional de Gravames (Alienação Fiduciária & Financiamentos)
# Consulta de restrições financeiras, arrendamento mercantil e leasing bancário
SNG_B3_GATEWAY_URL=https://sng.b3.com.br/api/v1/gravames
SNG_B3_API_KEY=

# 5. RENAINF / DETRAN - Registro Nacional de Infrações de Trânsito & Débitos
# Consulta de multas interestaduais, IPVA, Licenciamento anual e DPVAT/SPVAT
RENAINF_API_URL=https://renainf.senatran.gov.br/api/v1/infracoes
RENAINF_API_KEY=

# 6. OCR Vision Engine - Reconhecimento e Leitura de Placas por Imagem
# Processamento de fotos de veículos e placas Mercosul / antigas
OCR_VISION_API_KEY=

# 7. Gateway de Pagamento Pix Instantâneo (Mercado Pago / Efí Bank)
# Geração de QR Code Pix dinâmico com conciliação automática e baixa imediata
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
PIX_CHAVE_PADRAO=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# 8. Firebase Firestore & Autenticação (Google Cloud Platform)
# Persistência em nuvem segura de relatórios, usuários, créditos e logs de auditoria
FIREBASE_PROJECT_ID=ai-studio-autocheckbrasilb-581bf5f7-dc5a-4928-9f9e-3a3abfd5e3dc

# 9. Configurações Operacionais da Plataforma
# DEMO_MODE: false para forçar chamadas reais nos gateways; true para modo homologação
DEMO_MODE=false
CACHE_TTL_HOURS=24
QUERY_RATE_LIMIT_PER_MINUTE=60

# 10. Sentry SDK - Monitoramento de Erros e Rastreamento de Performance em Tempo Real
# Permite capturar falhas e latência em gateways e APIs silenciosamente
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

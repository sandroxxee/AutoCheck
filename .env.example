# ==============================================================================
# AutoCheck Brasil - Exemplo de variáveis de ambiente (SOMENTE PLACEHOLDERS)
# Copie para .env (ignorado pelo git) e na Vercel use Settings > Environment Variables.
# NUNCA coloque chaves reais neste arquivo.
# ==============================================================================

# 1. APIBrasil - consulta veicular por créditos (somente Bearer; DeviceToken é só para WhatsApp)
APIBRASIL_BEARER_TOKEN=
# false = consulta real (debita créditos). true = dados de teste.
APIBRASIL_HOMOLOG=false
APIBRASIL_BASE_URL=https://gateway.apibrasil.io/api/v2
APIBRASIL_BASE000_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/000
APIBRASIL_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/000
APIBRASIL_BASE001_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/001
APIBRASIL_BASE002_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/002
APIBRASIL_DEBITOS_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/002
APIBRASIL_BASE003_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/003
APIBRASIL_BASE004_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/004
APIBRASIL_BASE005_URL=https://gateway.apibrasil.io/api/v2/vehicles/base/005

# 2. BrasilAPI - base pública (FIPE, CEP, CNPJ)
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# 3. SINESP
SINESP_GATEWAY_URL=https://sinesp.mj.gov.br/api/v1/veiculos
SINESP_API_KEY=

# 4. SNG / B3
SNG_B3_GATEWAY_URL=https://sng.b3.com.br/api/v1/gravames
SNG_B3_API_KEY=

# 5. RENAINF / DETRAN
RENAINF_API_URL=https://renainf.senatran.gov.br/api/v1/infracoes
RENAINF_API_KEY=

# 6. OCR
OCR_VISION_API_KEY=

# 7. Pix (Mercado Pago / Efí Bank)
PIX_KEY=sandrooxxee@gmail.com
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
PIX_CHAVE_PADRAO=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# 8. Firebase
FIREBASE_PROJECT_ID=

# 9. Operação
DEMO_MODE=false
SESSION_SECRET=
CACHE_TTL_HOURS=24
QUERY_RATE_LIMIT_PER_MINUTE=60

# 10. Sentry
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
